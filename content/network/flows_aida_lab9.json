  {
    "id": "aida_color",
    "type": "ui-template",
    "z": "aida_lab9_tab",
    "name": "Selector de color WS2812B",
    "group": "aida_grp_ctrl",
    "order": 5,
    "width": 6,
    "height": 2,
    "head": "",
    "format": "<template>\n  <div style=\"display:flex;align-items:center;gap:14px;padding:6px 0\">\n    <input type=\"color\" v-model=\"color\" @change=\"sendColor()\"\n           style=\"width:64px;height:40px;border:none;background:none;cursor:pointer\" />\n    <div>\n      <div style=\"font-size:12px;opacity:.7\">Color WS2812B</div>\n      <code style=\"font-size:14px\">{{ color }}</code>\n    </div>\n  </div>\n</template>\n<script>\nexport default {\n  data () { return { color: '#00ff88' } },\n  methods: {\n    sendColor () {\n      this.send({ payload: JSON.stringify({ led_color: this.color }) })\n    }\n  }\n}\n</script>",

    "func": "// Slider 0-180 -> JSON de comando MQTT\nmsg.payload = JSON.stringify({ servo_angle: Number(msg.payload) || 0 });\nnode.status({ fill: \"blue\", shape: \"dot\", text: \"servo \" + msg.payload });\nreturn msg;",
